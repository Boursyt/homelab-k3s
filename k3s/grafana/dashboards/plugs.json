{
 "uid": "homelab-plugs",
 "title": "Smart plugs (Zigbee)",
 "tags": [
  "homelab",
  "zigbee",
  "energy"
 ],
 "schemaVersion": 39,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "timezone": "browser",
 "templating": {
  "list": [
   {
    "name": "plug",
    "label": "Plug",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "multi": true,
    "includeAll": true,
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "refresh": 2,
    "sort": 1,
    "query": {
     "query": "label_values(homeassistant_sensor_power_w, friendly_name)",
     "refId": "plug"
    },
    "regex": "/^(.*) Puissance$/"
   },
   {
    "name": "price",
    "label": "€ / kWh",
    "type": "textbox",
    "query": "0.25",
    "current": {
     "text": "0.25",
     "value": "0.25"
    }
   }
  ]
 },
 "panels": [
  {
   "type": "stat",
   "title": "Power now",
   "description": "total of the selected plugs, then each plug",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(homeassistant_sensor_power_w{friendly_name=~\"(${plug:regex}) (Puissance|Énergie|Tension|Courant)\"})",
     "legendFormat": "Total",
     "refId": "A",
     "instant": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "label_replace(homeassistant_sensor_power_w{friendly_name=~\"(${plug:regex}) (Puissance|Énergie|Tension|Courant)\"}, \"plug\", \"$1\", \"friendly_name\", \"(.*) (Puissance|Énergie|Tension|Courant)\")",
     "legendFormat": "{{plug}}",
     "refId": "B",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "watt",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "orange"
     }
    }
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value_and_name",
    "orientation": "vertical"
   },
   "id": 1,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 5
   }
  },
  {
   "type": "stat",
   "title": "Energy (period)",
   "description": "selected plugs, over the dashboard time range",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(integrate(homeassistant_sensor_power_w{friendly_name=~\"(${plug:regex}) (Puissance|Énergie|Tension|Courant)\"}[$__range])) / 3600000",
     "legendFormat": "Total",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "kwatth",
     "decimals": 2,
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
     }
    }
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "orientation": "vertical"
   },
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 5
   }
  },

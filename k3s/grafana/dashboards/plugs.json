      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(integrate(homeassistant_sensor_power_w{friendly_name=~\"(${plug:regex}) (Puissance|Énergie|Tension|Courant)\"}[30d])) / 3600000",
     "legendFormat": "Total",

  {
   "type": "stat",
   "title": "Cost (period)",
   "description": "selected plugs, over the dashboard time range, × the price per kWh at the top",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(integrate(homeassistant_sensor_power_w{friendly_name=~\"(${plug:regex}) (Puissance|Énergie|Tension|Courant)\"}[$__range])) / 3600000 * $price",

          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "refId": "A",
          "expr": "kubernetes.pod_namespace:in($namespace) kubernetes.pod_name:in($pod) $search | stats count_uniq(kubernetes.pod_name) pods",
          "queryType": "stats",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
